# Diomika — template .env (copiar para .env e preencher)
# NUNCA commitar secrets reais em repos publicos.

DIOMIKA_ENV=development

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=your-service-role-key
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_STORAGE_BUCKET=product-images

SUPABASE_DB_PASSWORD=

API_SECRET_KEY=generate-a-long-random-string
API_BASE_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=http://127.0.0.1:8000

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
CONTACT_NOTIFY_EMAIL=
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

# Producao (nao beta)
# ALLOWED_HOSTS=api.diomika.com
# DIOMIKA_ENV=production
# DIOMIKA_DESKTOP_GATE=  # >=24 chars; igual no WAF + build Electron (GitHub secret)
# ADMIN_BOOTSTRAP_USER=admin
# ADMIN_BOOTSTRAP_PASSWORD=  # forte; so cria user se admin_users.json vazio
# ADMIN_MFA_REQUIRED=0
# REDIS_URL=redis://127.0.0.1:6379/0
# SUPABASE_STORAGE_PRIVATE=1
# VITE_STORAGE_PRIVATE=1
# ALERT_WEBHOOK_URL=
# ALERT_LOG_FILE=deploy/alerts.log
# ALERT_LATENCY_MS=2000
# SENTRY_DSN=
# AXIOM_TOKEN=
# AXIOM_DATASET=diomika
# AXIOM_API_URL=https://eu-central-1.aws.edge.axiom.co
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
# LOG_FORMAT=json
# REMOTE_VM_SSH=
# CLOUDFLARE_TUNNEL_TOKEN=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Beta privada
# DIOMIKA_BETA=1
# TRUST_PROXY=1
