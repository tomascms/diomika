# Database Configuration
DATABASE_URL=postgresql://diomika_dev:diomika_dev_password@localhost:5432/diomika_dev

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=testing
AWS_SECRET_ACCESS_KEY=testing
AWS_DEFAULT_REGION=eu-west-1
AWS_S3_BUCKET_INVOICES=diomika-invoices
AWS_S3_BUCKET_IMAGES=diomika-images

# Email Configuration
EMAIL_API_KEY=test-sendgrid-key
EMAIL_FROM_ADDRESS=noreply@diomika.pt
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=test-sendgrid-key

# Slack Integration
SLACK_WEBHOOK_URL=http://localhost:9000/slack-mock

# PagerDuty Integration
PAGERDUTY_SERVICE_KEY=test-pagerduty-key
PAGERDUTY_EVENT_RULES_ENGINE_URL=https://events.pagerduty.com/v2/enqueue

# Security & Authentication
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# LocalStack (AWS Emulation)
LOCALSTACK_ENDPOINT_URL=http://localhost:4566
LOCALSTACK_REGION=eu-west-1

# Security Scanning
GITGUARDIAN_API_KEY=test-gitguardian-key
SONAR_TOKEN=test-sonarqube-token

# Feature Flags
ENABLE_INVOICE_GENERATION=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_AUDIT_ARCHIVAL=true
ENABLE_LOAD_TESTING=true

# Performance Tuning
DATABASE_POOL_MIN_SIZE=5
DATABASE_POOL_MAX_SIZE=20
REDIS_POOL_MIN_SIZE=1
REDIS_POOL_MAX_SIZE=10
REQUEST_TIMEOUT_SECONDS=30

# Logging
LOG_FORMAT=json
LOG_LEVEL=DEBUG

# Development-specific Settings
BYPASS_AUTH_LOCAL=true
ALLOW_CORS=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
