# Variáveis — produção endgame (€0 excepto domínio diomika.com)
# Copiar para .env na VM. Guia: deploy/FREE_STACK.md
#
# No PC (deploy): REMOTE_VM_SSH=user@IP_GCP_E2_MICRO

# Producao — SEM DIOMIKA_BETA, chaves Turnstile REAIS (deploy/TURNSTILE.md)
DIOMIKA_ENV=production
DIOMIKA_DOMAIN=diomika.com
RUN_EMBEDDED_WORKERS=true
# Com docker-compose.scale.yml usar false + workers dedicados
UVICORN_WORKERS=4
CATALOG_CACHE_TTL=60
RATE_LIMIT_CATALOG_PER_MIN=600
RATE_LIMIT_GLOBAL_PER_MIN=120
RATE_LIMIT_ADMIN_PER_MIN=300
# Chaves por scope (opcional mas recomendado)
# API_OPS_KEY=...
# API_CATALOG_KEY=...
# API_PEDIDOS_KEY=...
# API_MENSAGENS_KEY=...
ADMIN_MFA_REQUIRED=0
REDIS_URL=redis://127.0.0.1:6379/0
TRUSTED_PROXY_IPS=127.0.0.1,::1,172.16.0.0/12
SUPABASE_STORAGE_PRIVATE=1
STORAGE_SIGNED_URL_TTL=3600
STORAGE_MAX_UPLOAD_BYTES=5242880
# ALERT_WEBHOOK_URL=
# ALERT_LATENCY_MS=2000
# SENTRY_DSN=
# AXIOM_TOKEN=
# AXIOM_DATASET=diomika
# AXIOM_API_URL=https://eu-central-1.aws.edge.axiom.co
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=product-images
# R2_PUBLIC_BASE_URL=
TRUST_PROXY=1
PYTHONPATH=/app/backend-api

# URL pública via Cloudflare Tunnel ou DNS proxy
API_BASE_URL=https://api.diomika.com
ALLOWED_HOSTS=api.diomika.com

# Loja Cloudflare Pages (+ domínio final quando existir)
CORS_ORIGINS=https://www.diomika.com,https://diomika-loja.pages.dev

SUPABASE_URL=https://SEU_PROJECTO.supabase.co
SUPABASE_KEY=service_role_key
SUPABASE_STORAGE_BUCKET=product-images
SUPABASE_DB_PASSWORD=password_bd

API_SECRET_KEY=string_longa_aleatoria
# Login real do backoffice (Electron) — obrigatório para sessão utilizador
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=trocar_por_password_forte
# ADMIN_BOOTSTRAP_ROLE=admin
# ADMIN_SESSION_TTL_MINUTES=15
# ADMIN_LOGIN_MAX_FAILED=5
# ADMIN_LOGIN_LOCKOUT_MINUTES=15
# API_OPS_KEY / API_CATALOG_KEY / API_PEDIDOS_KEY / API_MENSAGENS_KEY — scopes finos
# MFA TOTP: POST /admin/auth/mfa/setup + /mfa/confirm (app autenticadora)
# Em producao final, /admin e /system so aceitam peer localhost.
# Nao activar salvo emergencia controlada:
# Gate do backoffice desktop (mesmo valor no build Electron + WAF Cloudflare)
# Gere: python -c "import secrets; print(secrets.token_urlsafe(32))"
DIOMIKA_DESKTOP_GATE=

# ADMIN_ALLOW_REMOTE — removido; use DIOMIKA_DESKTOP_GATE + app oficial

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
CONTACT_NOTIFY_EMAIL=

IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

TURNSTILE_SECRET_KEY=
OUTBOX_POLL_SECONDS=30
EMAIL_POLL_SECONDS=30
SAGA_SWEEP_SECONDS=300

# Só se usares docker compose --profile tunnel
# CLOUDFLARE_TUNNEL_TOKEN=eyJ...

# --- Cloudflare Pages (painel Pages, não na VM) ---
# VITE_API_BASE_URL=https://api.diomika.com
# VITE_SUPABASE_URL=...
# VITE_SUPABASE_ANON_KEY=...
# VITE_TURNSTILE_SITE_KEY=...
# VITE_STORAGE_PRIVATE=1
# VITE_SUPABASE_STORAGE_BUCKET=product-images

# --- Cloudflare API (PC de deploy, não obrigatório na VM) ---
# CLOUDFLARE_API_TOKEN=...
# CLOUDFLARE_ACCOUNT_ID=...
# Token Account (cfat_): precisa account_id + permissões Pages/Turnstile/WAF/Tunnel
# Comprar diomika.com na Cloudflare Registrar (único custo do projecto).
# Token: Pages/Turnstile/WAF/Tunnel + zone se criares zona via API.
