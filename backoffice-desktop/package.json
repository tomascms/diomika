{
  "name": "backoffice-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Diomika Backoffice — app de secretária (Windows / macOS / Linux)",
  "author": "Diomika",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5174 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5174 electron .\"",
    "dev:ui": "vite",
    "dev:browser": "vite --open",
    "build": "vite build",
    "start": "electron .",
    "dist": "npm run dist:win",
    "dist:win": "node scripts/write-gate.cjs && vite build && electron-builder --win zip --x64",
    "dist:mac": "node scripts/write-gate.cjs && vite build && electron-builder --mac dmg --universal",
    "dist:linux": "node scripts/write-gate.cjs && vite build && electron-builder --linux AppImage --x64",
    "dist:cliente": "node scripts/build-cliente-pack.cjs",
    "dist:dir": "node scripts/write-gate.cjs && vite build && electron-builder --dir"
  },
  "build": {
    "appId": "pt.diomika.backoffice",
    "productName": "Diomika Backoffice",
    "copyright": "Copyright © Diomika",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": ["zip"],
      "signAndEditExecutable": false,
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "Diomika-Backoffice-${version}-windows.zip"
    },
    "nsis": {
      "packElevateHelper": false,
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false
    },
    "portable": {
      "artifactName": "Diomika-Backoffice-${version}-windows.exe"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.business",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "artifactName": "Diomika-Backoffice-${version}-mac.dmg"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Office",
      "artifactName": "Diomika-Backoffice-${version}-linux.AppImage"
    }
  },
  "dependencies": {
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "vite": "^8.0.8",
    "wait-on": "^9.1.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
