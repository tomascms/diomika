{
  "description": "Diomika — regras WAF/edge (aplicar com deploy/apply_waf.py)",
  "zone_settings": {
    "ssl": "strict",
    "always_use_https": "on",
    "min_tls_version": "1.2",
    "security_level": "high",
    "browser_check": "on"
  },
  "rate_limits": [
    {
      "name": "diomika-api-write",
      "match": "*(/contacto|/orcamentos)*",
      "threshold": 30,
      "period": 60,
      "action": "block"
    },
    {
      "name": "diomika-api-global",
      "match": "*",
      "threshold": 300,
      "period": 60,
      "action": "challenge"
    }
  ],
  "firewall_rules": [
    {
      "name": "block-empty-ua",
      "expression": "(http.user_agent eq \"\")",
      "action": "block",
      "description": "Bloquear pedidos sem User-Agent"
    },
    {
      "name": "challenge-admin-paths",
      "expression": "(http.request.uri.path contains \"/admin\" or http.request.uri.path contains \"/system\")",
      "action": "block",
      "description": "Admin/system nunca devem chegar via edge público"
    }
  ]
}
